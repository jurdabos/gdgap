# Secrets: put them in .env like any other variable, and everything works with no keyring involved.
# Optional: "uv run acidbase keyring plan", then "copy" and "strip", moves them into the OS keyring and leaves a
# "# keyring: NAME" line in .env. A startup hook from acidbase then fills the environment of each Python process in
# this repo, and a variable already set in the environment wins. "restore" undoes the move.
# Docker Compose reads .env itself and never sees keyring values, so keep what the containers need in .env.

# Compose interpolates the container root password (compose.yaml, ADR-0008)
GDGAP_MYSQL_ROOT_PASSWORD=REAL-MYSQL-ROOT-PASSWORD
# The InnoDB foil endpoint: the compose-managed MySQL container on loopback
GDGAP_MYSQL_URL=mysql+pymysql://root:REAL-MYSQL-ROOT-PASSWORD@*********:3307
# Dedicated DISPOSABLE MySQL endpoint for the live-InnoDB tests — never the evidence server above.
# Tests refuse to run when this resolves to the same host:port as GDGAP_MYSQL_URL.
# Throwaway example: docker run --rm -d -e MYSQL_ROOT_PASSWORD=REAL-TEST-PASSWORD -p 3308:3306 mysql:8.4.11
# GDGAP_MYSQL_TEST_URL=mysql+pymysql://root:REAL-TEST-PASSWORD@*********:3308
# Bench2 buffer-pool condition (ADR-0011): unset = 128 MB default (c1/c3); 1073741824 = 1 GiB (c2).
# Recreate the container after changing it: docker compose up -d --force-recreate --wait
# GDGAP_MYSQL_BUFFER_POOL=1073741824
MOTHERDUCK_TOKEN=REAL-MOTHERDUCK-TOKEN
