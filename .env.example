# Compose interpolates the container root password (compose.yaml, ADR-0008)
GDGAP_MYSQL_ROOT_PASSWORD=REAL-MYSQL-ROOT-PASSWORD
# The InnoDB foil endpoint: the compose-managed MySQL container on loopback
GDGAP_MYSQL_URL=mysql+pymysql://root:REAL-MYSQL-ROOT-PASSWORD@*********:3307
# Dedicated DISPOSABLE MySQL endpoint for the live-InnoDB tests — never the evidence server above.
# Tests refuse to run when this resolves to the same host:port as GDGAP_MYSQL_URL.
# Throwaway example: docker run --rm -d -e MYSQL_ROOT_PASSWORD=REAL-TEST-PASSWORD -p 3308:3306 mysql:8.4.11
# GDGAP_MYSQL_TEST_URL=mysql+pymysql://root:REAL-TEST-PASSWORD@*********:3308
MOTHERDUCK_TOKEN=REAL-MOTHERDUCK-TOKEN
